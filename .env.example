# ChiliDiaries — переменные окружения для интеграции с Supabase (Этап 7).
# Скопируй в .env.local (для Vite) и заполни реальными значениями из
# Supabase Dashboard → Project Settings → API. Сам .env.local в .gitignore —
# не коммить реальные ключи.

# Публичные — идут в клиентский бандл (префикс VITE_ обязателен для Vite,
# иначе переменная не попадёт в import.meta.env). Anon key безопасен для
# фронтенда — доступ к данным ограничивается RLS-политиками
# (см. supabase/migrations/0003_rls_policies.sql), а не секретностью ключа.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Секретный — ТОЛЬКО для серверных скриптов (scripts/migrate-seed-to-supabase.mjs,
# Этап 6). Обходит RLS полностью. НИКОГДА не использовать в клиентском коде,
# не коммитить, не логировать.
SUPABASE_SERVICE_ROLE_KEY=
